# AI providers, tried in this order: Gemini -> Groq -> built-in mock. Both keys are optional; with neither set the app runs in mock mode.
# Gemini key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Groq key (free tier, OpenAI-compatible): https://console.groq.com/keys
GROQ_API_KEY=

# Models (both are checked against the provider's model list on boot and corrected if unavailable)
# GEMINI_MODEL=gemini-flash-latest
# GEMINI_FALLBACK_MODEL=gemini-flash-lite-latest
# GROQ_MODEL=llama-3.3-70b-versatile

# Per-provider request budgets. Traffic is routed to the next provider BEFORE a limit is hit.
# Set these to your own free-tier limits. Daily counters persist across restarts and reset at midnight
# Pacific time (Gemini) / 00:00 UTC (Groq). Ambient bot activity is capped at ~60% of RPM / 80% of daily
# so player-facing calls (reactions, replies, DMs) always have headroom.
# GEMINI_RPM=10
# GEMINI_RPD=250
# GROQ_RPM=25
# GROQ_RPD=900

# Persistence. Leave MONGODB_URI empty to keep using data/state.json. Set it (MongoDB Atlas free M0) on hosts without a disk, e.g. Render free.
# Game state and uploaded avatars/banners then live in MongoDB; an empty database imports data/state.json once.
MONGODB_URI=
# MONGODB_DB=owlfeed        used only when the URI has no database name

# Sign-up gate: when set, new accounts must enter this code
INVITE_CODE=

# Other
# AI_MIN_GAP_MS=2500        minimum spacing between AI calls
# AI_PER_MIN=               optional extra global cap on calls per minute (jobs wait, DMs go first)
# TICK_MS=150000            how often bots post on their own while someone is online
# PORT=3000
# DATA_DIR=./data

# Testing only: point a provider at a fake local endpoint
# GEMINI_BASE_URL=http://127.0.0.1:4010
# GROQ_BASE_URL=http://127.0.0.1:4011
